{
  "id": "/safety-fieldbook/",
  "name": "Safety Fieldbook",
  "short_name": "Fieldbook",
  "description": "A lightweight app for on-site inspections, photos and findings—even offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f7fa",
  "theme_color": "#003D7C",
  "lang": "en",
  "icons": [
    {
      "src": "icon-rounded-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-rounded-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "https://kengbeng.github.io/safety-fieldbook/"
    }
  ]
}
